# Choose your LLM provider: openai, anthropic, groq, or ollama
LLM_PROVIDER=groq

# Groq Configuration (Recommended for Production)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (Local - Optional)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# ── Chains: Ethereum · Solana · Monad ──
NEXT_PUBLIC_ETH_RPC_URL=https://ethereum-rpc.publicnode.com
NEXT_PUBLIC_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com
NEXT_PUBLIC_SOLANA_DEVNET_RPC=https://api.devnet.solana.com

# Monad Testnet (Blitz / public testnet)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_MONAD_FAUCET_URL=https://faucet.monad.xyz

# ── DronaHQ sync (optional — contacts + activity mirror) ──
# Point at your DronaHQ REST endpoint / automation webhook that writes to
# Sheets or manageddb. Leave unset for offline-first local mode.
# DRONAHQ_SYNC_URL=https://your-dronahq-host/api/aawaz/ingest
# DRONAHQ_SYNC_KEY=YOUR_DRONAHQ_TOKEN
# DRONAHQ_SYNC_TABLE_CONTACTS=aawaz_contacts
# DRONAHQ_SYNC_TABLE_ACTIVITY=aawaz_activity

# Fish Audio (celebrity voices incl. Modi) — paste your key, restart dev server
# Key: https://fish.audio/go-api
FISH_AUDIO_API_KEY=YOUR_FISH_AUDIO_KEY
# Voice model IDs from Fish Studio (create/clone a voice → copy its ID)
FISH_AUDIO_MODI_REFERENCE_ID=https://fish.audio/m/03e679752fa54b778a189c9f4e9d1889
FISH_AUDIO_TRUMP_REFERENCE_ID=https://fish.audio/m/76122219d4ce4c69a572e80c945c747d
FISH_AUDIO_BACHCHAN_REFERENCE_ID=https://fish.audio/m/c18ab922328443379f46d8aa53afdf44
