# Choose your LLM provider: openai, anthropic, groq, or ollama
LLM_PROVIDER=groq

# Groq Configuration (Recommended for Production)
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.1-8b-instant

# Ollama Configuration (Local - Optional)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Monad Testnet (Blitz / public testnet)
NEXT_PUBLIC_MONAD_RPC_URL=https://testnet-rpc.monad.xyz
NEXT_PUBLIC_MONAD_CHAIN_ID=10143
NEXT_PUBLIC_MONAD_EXPLORER_URL=https://testnet.monadvision.com
NEXT_PUBLIC_MONAD_FAUCET_URL=https://faucet.monad.xyz

# Fish Audio Configuration (Optional - For Celebrity Voice Generation)
# FISH_AUDIO_API_KEY=YOUR_API_KEY_HERE
